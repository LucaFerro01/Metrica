# Base URL dell'API vista dal browser (DEC-015). Predefinita: /api, inoltrata dal dev server di Vite
# al gateway (http://127.0.0.1:5080), quindi nessun CORS.
# Per un guscio nativo o per un gateway su un'altra origine usare un URL assoluto, ad es.
#   VITE_API_BASE_URL=https://gateway.example.test/api
# Senza barra finale (se presente viene tolta). Copiare in .env.local (non versionato) per cambiarla.
VITE_API_BASE_URL=/api
