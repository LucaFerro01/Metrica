{
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5080"
      }
    }
  },
  "Gateway": {
    "MaxRequestBodyBytes": 34603008
  },
  "ReverseProxy": {
    "Routes": {
      "ingestion": {
        "ClusterId": "ingestion",
        "Match": {
          "Path": "/api/ingestion/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/ingestion" }
        ]
      },
      "activities": {
        "ClusterId": "activities",
        "Match": {
          "Path": "/api/activities/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      }
    },
    "Clusters": {
      "ingestion": {
        "Destinations": {
          "primary": { "Address": "http://127.0.0.1:5081" }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:01:40"
        }
      },
      "activities": {
        "Destinations": {
          "primary": { "Address": "http://127.0.0.1:5082" }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:01:40"
        }
      }
    }
  }
}
