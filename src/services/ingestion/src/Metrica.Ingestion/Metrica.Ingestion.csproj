<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Servizio ingestion: host web, persistenza (schema "ingestion") e parsing dei file GPX e FIT dietro IActivityFileParser.
       Endpoint di upload (T10) e deduplicazione con outbox. I parser non referenziano il logging di proposito: nessun dato del file
       deve poter uscire (REQ-034). -->

  <ItemGroup>
    <PackageReference Include="Garmin.FIT.Sdk" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Solo strumenti di progettazione (dotnet ef): non deve propagarsi ai progetti che referenziano il servizio. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\shared\contracts\Metrica.Contracts\Metrica.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\shared\ServiceDefaults\Metrica.ServiceDefaults\Metrica.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\..\..\shared\Messaging\Metrica.Messaging\Metrica.Messaging.csproj" />
  </ItemGroup>

</Project>
