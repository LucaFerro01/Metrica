<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Solo nuget.org: tutti i pacchetti del progetto sono pubblici.
       Con la gestione centralizzata delle versioni, piu fonti non mappate producono l'errore NU1507. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
