<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test di integrazione end-to-end (T15): contenitori reali (TimescaleDB, NATS) e i tre servizi reali in processo su Kestrel
       con porta effimera. I tre Program sono tipi omonimi in assembly diversi: gli alias distinguono le tre
       referenze (extern alias nei file degli host). -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="NATS.Net" />
    <PackageReference Include="Garmin.FIT.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\services\ingestion\src\TriMetric.Ingestion\TriMetric.Ingestion.csproj" Aliases="IngestionApp" />
    <ProjectReference Include="..\..\src\services\activities\src\TriMetric.Activities\TriMetric.Activities.csproj" Aliases="ActivitiesApp" />
    <ProjectReference Include="..\..\src\services\gateway\src\TriMetric.Gateway\TriMetric.Gateway.csproj" Aliases="GatewayApp" />
    <ProjectReference Include="..\..\src\shared\contracts\TriMetric.Contracts\TriMetric.Contracts.csproj" />
    <ProjectReference Include="..\..\src\shared\Messaging\TriMetric.Messaging\TriMetric.Messaging.csproj" />
    <ProjectReference Include="..\TriMetric.TestInfrastructure\TriMetric.TestInfrastructure.csproj" />
  </ItemGroup>

  <!-- Ogni servizio legge appsettings*.json dalla cartella dei binari (content root = AppContext.BaseDirectory): con tre servizi nello
       stesso processo i file omonimi si sovrascriverebbero in modo dipendente dall'ordine di build. Non si copiano: gli host
       caricano i file REALI di ciascun servizio dal repository (vedi ServiceConfiguration). -->
  <Target Name="DropServiceAppSettings" AfterTargets="GetCopyToOutputDirectoryItems">
    <ItemGroup>
      <_SourceItemsToCopyToOutputDirectory Remove="@(_SourceItemsToCopyToOutputDirectory)"
                                           Condition="$([System.String]::new('%(Filename)').StartsWith('appsettings')) And '%(Extension)' == '.json'" />
      <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_SourceItemsToCopyToOutputDirectoryAlways)"
                                                 Condition="$([System.String]::new('%(Filename)').StartsWith('appsettings')) And '%(Extension)' == '.json'" />
    </ItemGroup>
  </Target>

</Project>
